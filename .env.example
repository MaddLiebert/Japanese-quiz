# Supabase — konfigurasi sync & leaderboard
# Salin file ini menjadi `.env` (lokal) dan isi nilainya.
# Di Vercel: Project → Settings → Environment Variables (tambahkan keduanya).
#
# Keduanya AMAN ditaruh di frontend (anon key memang untuk publik; keamanan
# diatur oleh Row Level Security di supabase/schema.sql).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Audio MNN (87 file, 165 MB) TIDAK lagi ikut ke-deploy Vercel (jatah Deployment
# Storage Hobby cuma 10 GB; dulu tiap deploy ~181 MB). File-nya di Supabase
# Storage bucket publik `audio`, dan app memuatnya dari sini.
# Kosongkan (atau hapus baris) untuk pakai audio LOKAL dari public/audio (dev).
# Contoh: https://<ref>.supabase.co/storage/v1/object/public/audio
VITE_AUDIO_BASE_URL=
